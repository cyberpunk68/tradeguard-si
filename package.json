{
  "name": "tradeguard",
  "version": "0.1.0",
  "description": "Chrome extension that adds friction and lockouts before bad crypto trades, with mood tracking.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock": "node scripts/mock-server.mjs",
    "zip": "node scripts/build.mjs --store && cd dist && zip -qr ../tradeguard.zip .",
    "e2e": "node tests/e2e/e2e.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
  "author": "TradeGuard SI authors",
  "license": "AGPL-3.0-only",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  }
}
